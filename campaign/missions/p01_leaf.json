	"speakers": {
		"king": {
			"name": "The King",
			"side": "crown"
		},
		"tomasz": {
			"name": "Tomasz",
			"side": "crown"
		},
		"fairleigh": {
			"name": "Lord Fairleigh",
			"side": "crown"
		},
		"ruggieri": {
			"name": "Captain Ruggieri",
			"side": "crown"
		},
		"varenne": {
			"name": "Varenne",
			"side": "rebels"
		}
	},
	"lines": {
		"k_open1": {
			"who": "king",
			"text": "You ask how the world came to burn. Sit. Let an old man light his pipe first. The leaf is from Virginia. It is fitting. That is where it began."
		},
		"k_open2": {
			"who": "king",
			"text": "In those days the sun did not set on the Crown. From Rome to the farthest islands there was one faith, one law, one King. We were not perfect. But we were at peace, and we thought peace was the natural state of things."
		},
		"k_open3": {
			"who": "king",
			"text": "Virginia gave us its golden leaf, and gave its sons to the seminaries. That summer a young Pole, Tomasz Wierzbicki, waited there for his ship to Rome."
		},
		"t_open3": {
			"who": "tomasz",
			"text": "I remember the smell of the drying barns, and how quiet the evenings were. I was reading Augustine under the oak. I thought I knew what evil was."
		},
		"k_open4": {
			"who": "king",
			"text": "Then came the men who called themselves the Free Assembly. Free of God, free of their King, free of every bond that had kept them fed and safe. They began, as such men always do, with fire."
		},
		"f_open5": {
			"who": "fairleigh",
			"text": "Captain Ruggieri, run out the guns. No man burns the King's leaf while I stand on these steps."
		},
		"t_open5": {
			"who": "tomasz",
			"text": "He did not raise his voice. He did not need to."
		},
		"t_end": {
			"who": "tomasz",
			"text": "I prayed for them that morning, and I pray for them still. But I never again believed that disorder was a kind of mercy."
		},
		"k_end": {
			"who": "king",
			"text": "Fairleigh ended the rising in a single morning. We thought it was over. It was the first spark."
		},
		"p1_fair": {
			"who": "fairleigh",
			"text": "Musketeers to the barns. Captain, your guns on the lawn. We hold until the sun comes up."
		},
		"p1_rugg": {
			"who": "ruggieri",
			"text": "The guns are run out, my lord. Let them come into the light."
		},
		"p1_tip": {
			"who": "ruggieri",
			"to": "crown",
			"text": "Train more men at the Barracks, my lord. Kill the torch-bearers first: a barn they reach will burn."
		},
		"v_1": {
			"who": "varenne",
			"text": "No king but the people! Burn the leaf of the tyrants!"
		},
		"r_1": {
			"who": "ruggieri",
			"text": "Give fire!"
		},
		"t_1": {
			"who": "tomasz",
			"text": "They carried pitchforks and torches, and some of them were boys. I knelt by the first one who fell. He was already gone."
		},
		"v_2": {
			"who": "varenne",
			"text": "Free of priests! Free of lords! Liberty or the grave!"
		},
		"f_1": {
			"who": "fairleigh",
			"text": "That is their orator. He shouts from the dark and sends others into the light."
		},
		"r_2": {
			"who": "ruggieri",
			"text": "Steady, gentlemen. Let them close. Then give it to them."
		},
		"v_3": {
			"who": "varenne",
			"text": "Every barn that burns is a chain broken!"
		},
		"r_leaf": {
			"who": "ruggieri",
			"text": "A whole year's leaf, my lord. I could weep. I shall want my pipe after this."
		},
		"f_leaf": {
			"who": "fairleigh",
			"text": "You shall have it, Captain. And they shall have the guns."
		},
		"v_4": {
			"who": "varenne",
			"text": "Now, brothers! All of you! Let it burn!"
		},
		"t_2": {
			"who": "tomasz",
			"text": "They burned the curing sheds with families sleeping beside them. I learned that night what their freedom meant."
		},
		"r_3": {
			"who": "ruggieri",
			"text": "Fewer of them now. Keep firing."
		},
		"t_lauds": {
			"who": "tomasz",
			"text": "Then the sky went grey over the woods, and the chapel bell rang for Lauds."
		},
		"f_barn": {
			"who": "fairleigh",
			"text": "A barn is alight. Drive them off it!"
		},
		"t_barn": {
			"who": "tomasz",
			"text": "The first barn fell in. The leaf went up like incense, and the smell was everywhere."
		},
		"f_manor": {
			"who": "fairleigh",
			"text": "They are at the house. To the manor!"
		},
		"f_ash": {
			"who": "fairleigh",
			"text": "The leaf is ash. Virginia has lost its year, and we have lost Virginia."
		},
		"f_dawn": {
			"who": "fairleigh",
			"text": "Dawn. They are falling back to the fort. We follow."
		},
		"r_dawn": {
			"who": "ruggieri",
			"text": "Limber the guns! Down the road!"
		},
		"p2_tip": {
			"who": "ruggieri",
			"to": "crown",
			"text": "Two camps lie on the road to the fort. A cannon must be limbered to march and set up again to fire."
		},
		"r_intro": {
			"who": "varenne",
			"to": "rebels",
			"text": "Tonight we burn their leaf and their manor. Out of the fields, brothers!"
		},
		"r_dawn_v": {
			"who": "varenne",
			"to": "rebels",
			"text": "Back to the fort! Let them come to our walls."
		},
		"t_smoke": {
			"who": "tomasz",
			"text": "Smoke to the north, my lord. Hollins Farm. The families there are loyal, and they are trapped."
		},
		"f_choice": {
			"who": "fairleigh",
			"text": "Every hour we spend there, they dig in at the fort."
		},
		"f_save": {
			"who": "fairleigh",
			"text": "We do not leave the King's people to burn. North."
		},
		"f_leave": {
			"who": "fairleigh",
			"text": "The fort first. God keep them."
		},
		"t_saved": {
			"who": "tomasz",
			"text": "They came out of the smoke carrying their children. A woman kissed the Governor's hand. He did not know where to look."
		},
		"f_late": {
			"who": "fairleigh",
			"text": "To the road again. We are late."
		},
		"t_toolate": {
			"who": "tomasz",
			"text": "We came too late. I said the prayers for the dead over them, and we marched on."
		},
		"t_left": {
			"who": "tomasz",
			"text": "We saw the smoke of Hollins Farm for an hour. No one spoke of it. I have prayed for those families every year since."
		},
		"f_fort": {
			"who": "fairleigh",
			"text": "The road is clear. The fort."
		},
		"r_mass": {
			"who": "ruggieri",
			"text": "They are massing behind the gate, my lord. Hundreds of them."
		},
		"f_canister_load": {
			"who": "fairleigh",
			"text": "Bring the guns up. Load canister."
		},
		"tip_canister": {
			"who": "ruggieri",
			"to": "crown",
			"phone": "Tap a cannon, then CANISTER on its card. Canister reaches short and cuts down a crowd.",
			"text": "Select a cannon and press CANISTER on its card. Canister reaches short and cuts down a crowd."
		},
		"r_dug": {
			"who": "ruggieri",
			"text": "They have had time to dig in. More of them than I would like."
		},
		"v_5": {
			"who": "varenne",
			"text": "Brothers! Their guns are few! One charge and Virginia is free!"
		},
		"f_word": {
			"who": "fairleigh",
			"text": "Canister. On my word."
		},
		"v_charge": {
			"who": "varenne",
			"text": "Forward! For the people!"
		},
		"f_fire": {
			"who": "fairleigh",
			"text": "Fire."
		},
		"r_varenne": {
			"who": "ruggieri",
			"text": "Their orator is down."
		}
	},
